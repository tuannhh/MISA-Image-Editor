<Window x:Class="MisaImageEditor.Desktop.CopySettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy Settings" Height="330" Width="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="InstructionText" Text="Choose settings to copy to the selected photos." TextWrapping="Wrap" Margin="0,0,0,12"/>
        <StackPanel Grid.Row="1">
            <CheckBox x:Name="BasicCheckBox" Content="Basic adjustments (exposure, contrast, highlights, shadows, whites, blacks, saturation)" IsChecked="True" Margin="0,5"/>
            <CheckBox x:Name="ToneCurveCheckBox" Content="Tone Curve" IsChecked="True" Margin="0,5"/>
            <CheckBox x:Name="ColorMixerCheckBox" Content="Color Mixer / HSL" IsChecked="True" Margin="0,5"/>
            <CheckBox x:Name="LensCorrectionCheckBox" Content="Lens Correction" IsChecked="True" Margin="0,5"/>
            <CheckBox x:Name="CropCheckBox" Content="Crop and transform" IsChecked="True" Margin="0,5"/>
            <CheckBox x:Name="MaskCheckBox" Content="Mask and local adjustments" IsChecked="True" Margin="0,5"/>
            <CheckBox x:Name="WatermarkCheckBox" Content="Export watermark and resize settings" IsChecked="True" Margin="0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="CheckAllButton" Content="Check all" Click="CheckAll_Click" Padding="12,5" Margin="0,0,8,0"/>
                <Button x:Name="CheckNoneButton" Content="Check none" Click="CheckNone_Click" Padding="12,5"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CopyButton" Content="Copy" IsDefault="True" Click="Copy_Click" Padding="18,6" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Click="Cancel_Click" Padding="18,6"/>
        </StackPanel>
    </Grid>
</Window>
