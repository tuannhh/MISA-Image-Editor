{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MISA Image Editor recipe v1",
  "type": "object",
  "required": ["schema_version", "process_version", "basic", "crop"],
  "properties": {
    "schema_version": {"const": 1},
    "process_version": {"type": "string", "minLength": 1},
    "basic": {
      "type": "object",
      "properties": {
        "exposure": {"type": "number", "minimum": -5, "maximum": 5},
        "contrast": {"type": "number", "minimum": -100, "maximum": 100},
        "highlights": {"type": "number", "minimum": -100, "maximum": 100},
        "shadows": {"type": "number", "minimum": -100, "maximum": 100},
        "whites": {"type": "number", "minimum": -100, "maximum": 100},
        "blacks": {"type": "number", "minimum": -100, "maximum": 100},
        "saturation": {"type": "number", "minimum": -100, "maximum": 100}
      },
      "additionalProperties": false
    },
    "tone_curve": {
      "type": "object",
      "properties": {
        "shadows": {"type": "number", "minimum": -100, "maximum": 100},
        "darks": {"type": "number", "minimum": -100, "maximum": 100},
        "lights": {"type": "number", "minimum": -100, "maximum": 100},
        "highlights": {"type": "number", "minimum": -100, "maximum": 100}
      },
      "additionalProperties": false
    },
    "color_mixer": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "object",
          "patternProperties": {
            "^(red|orange|yellow|green|aqua|blue|purple|magenta)$": {
              "type": "object",
              "properties": {
                "hue": {"type": "number", "minimum": -100, "maximum": 100},
                "saturation": {"type": "number", "minimum": -100, "maximum": 100},
                "luminance": {"type": "number", "minimum": -100, "maximum": 100}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "lens_correction": {
      "type": "object",
      "properties": {
        "profile_id": {"type": ["string", "null"]},
        "profile_enabled": {"type": "boolean"},
        "distortion": {"type": "number", "minimum": -100, "maximum": 100},
        "vignetting": {"type": "number", "minimum": -100, "maximum": 100}
      },
      "additionalProperties": false
    },
    "crop": {
      "type": "object",
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": {"type": "number", "minimum": 0, "maximum": 1},
        "top": {"type": "number", "minimum": 0, "maximum": 1},
        "right": {"type": "number", "minimum": 0, "maximum": 1},
        "bottom": {"type": "number", "minimum": 0, "maximum": 1},
        "angle": {"type": "number", "minimum": -180, "maximum": 180},
        "aspect": {"enum": ["original", "1:1", "4:3", "3:2", "16:9"]}
      },
      "additionalProperties": false
    },
    "watermark": {
      "type": ["object", "null"],
      "properties": {
        "text": {"type": ["string", "null"]},
        "opacity": {"type": "number", "minimum": 0, "maximum": 100},
        "margin": {"type": "integer", "minimum": 0},
        "position": {"enum": ["top_left", "top_right", "center", "bottom_left", "bottom_right"]},
        "width": {"type": ["integer", "null"], "minimum": 1},
        "height": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": false
    },
    "mask": {
      "type": ["object", "null"],
      "properties": {
        "type": {"enum": ["rectangle", "raster"]},
        "path": {"type": "string", "minLength": 1},
        "invert": {"type": "boolean"},
        "left": {"type": "number", "minimum": 0, "maximum": 1},
        "top": {"type": "number", "minimum": 0, "maximum": 1},
        "right": {"type": "number", "minimum": 0, "maximum": 1},
        "bottom": {"type": "number", "minimum": 0, "maximum": 1},
        "basic": {"$ref": "#/$defs/basic"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "basic": {
      "type": "object",
      "properties": {
        "exposure": {"type": "number", "minimum": -5, "maximum": 5},
        "contrast": {"type": "number", "minimum": -100, "maximum": 100},
        "highlights": {"type": "number", "minimum": -100, "maximum": 100},
        "shadows": {"type": "number", "minimum": -100, "maximum": 100},
        "whites": {"type": "number", "minimum": -100, "maximum": 100},
        "blacks": {"type": "number", "minimum": -100, "maximum": 100},
        "saturation": {"type": "number", "minimum": -100, "maximum": 100}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
