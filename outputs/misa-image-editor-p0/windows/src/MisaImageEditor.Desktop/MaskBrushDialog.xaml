<Window x:Class="MisaImageEditor.Desktop.MaskBrushDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paint Mask" Height="720" Width="980"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource PreviewBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid x:Name="PaintingSurface" Background="{DynamicResource PreviewBackgroundBrush}">
                <Image x:Name="SourceImage" Stretch="Fill" IsHitTestVisible="False"/>
                <Canvas x:Name="BrushCanvas" Background="Transparent"
                        MouseLeftButtonDown="BrushCanvas_MouseLeftButtonDown"
                        MouseMove="BrushCanvas_MouseMove"
                        MouseLeftButtonUp="BrushCanvas_MouseLeftButtonUp"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock x:Name="InstructionText" Text="Paint white into the mask. Black remains unmasked; mask coordinates follow the original image." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="BrushSizeLabel" Text="Brush size" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider Grid.Column="1" x:Name="BrushSizeSlider" Minimum="4" Maximum="400" Value="80" ValueChanged="BrushSettingChanged"/>
                <TextBlock Grid.Column="2" x:Name="BrushSizeValue" Text="80 px" Foreground="{DynamicResource SecondaryTextBrush}" Margin="12,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="HardnessLabel" Grid.Column="2" Text="Hardness" Foreground="{DynamicResource PrimaryTextBrush}" Margin="80,0,8,0" VerticalAlignment="Center"/>
                <Slider Grid.Column="3" x:Name="BrushHardnessSlider" Minimum="0" Maximum="100" Value="70" ValueChanged="BrushSettingChanged"/>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="ClearButton" Content="Clear" Click="Clear_Click" Padding="18,6" Margin="0,0,8,0"/>
                <Button x:Name="SaveButton" Content="Save mask" IsDefault="True" Click="Save_Click" Padding="18,6" Margin="0,0,8,0"/>
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Click="Cancel_Click" Padding="18,6"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
