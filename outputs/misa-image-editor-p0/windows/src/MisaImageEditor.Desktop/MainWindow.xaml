<Window x:Class="MisaImageEditor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MisaImageEditor.Desktop"
        Title="MISA Image Editor - P0"
        Height="760" Width="1280" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        PreviewKeyDown="Window_KeyDown" FontFamily="Segoe UI" FontSize="13" MinWidth="1050" MinHeight="650">
    <Window.Resources>
        <local:LocalizationService x:Key="I18n" />
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupBox"><StackPanel><TextBlock Text="{TemplateBinding Header}" FontWeight="SemiBold" Margin="0,10,0,12"/><ContentPresenter Margin="{TemplateBinding Padding}"/><Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,4"/></StackPanel></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="Margin" Value="3"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource TopBarBackgroundBrush}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="9" Width="34" Height="34" Margin="0,0,12,0"><TextBlock Text="Mi" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="{Binding [AppProduct], Source={StaticResource I18n}}" FontSize="18" FontWeight="SemiBold" Margin="0,0,26,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="LibraryTab" Content="{Binding [NavLibrary], Source={StaticResource I18n}}" IsChecked="True" GroupName="Tabs" Margin="8,0" Checked="LibraryTab_Checked"/>
                    <RadioButton x:Name="EditorTab" Content="{Binding [NavEditor], Source={StaticResource I18n}}" GroupName="Tabs" Margin="8,0" Checked="EditorTab_Checked"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Language], Source={StaticResource I18n}}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="LanguageSelector" Width="105" Margin="6,0,16,0" SelectionChanged="LanguageSelector_SelectionChanged">
                        <ComboBoxItem Tag="vi" Content="Tiếng Việt"/>
                        <ComboBoxItem Tag="en" Content="English"/>
                    </ComboBox>
                    <TextBlock Text="{Binding [Theme], Source={StaticResource I18n}}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ThemeSelector" Width="118" Margin="6,0,16,0" SelectionChanged="ThemeSelector_SelectionChanged">
                        <ComboBoxItem Tag="light" Content="{Binding [ThemeLight], Source={StaticResource I18n}}"/>
                        <ComboBoxItem Tag="dark" Content="{Binding [ThemeDark], Source={StaticResource I18n}}"/>
                        <ComboBoxItem Tag="system" Content="{Binding [ThemeSystem], Source={StaticResource I18n}}"/>
                    </ComboBox>
                                    </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top" Padding="20,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><DockPanel>
            <Button DockPanel.Dock="Right" Content="{Binding [AddToTarget], Source={StaticResource I18n}}" Click="AddToTarget_Click"/>
            <TextBlock x:Name="TargetText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="12,0"/>
            <TextBlock x:Name="ActivePhotoText" Text="{Binding [NavLibrary], Source={StaticResource I18n}}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel></Border>
        <ProgressBar x:Name="ImportProgress" DockPanel.Dock="Bottom" IsIndeterminate="True" Height="3" Visibility="Collapsed"/>
        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource TopBarBackgroundBrush}" Foreground="{DynamicResource SecondaryTextBrush}">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="{Binding [ReadyImport], Source={StaticResource I18n}}"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="CountText" Text="0"/></StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition/><ColumnDefinition x:Name="EditorColumn" Width="320"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" Padding="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Button x:Name="ImportButton" Content="{Binding [ImportFolder], Source={StaticResource I18n}}" Click="ImportFolder_Click"/>
                        <Button Content="{Binding [CreateCollection], Source={StaticResource I18n}}" Click="CreateCollection_Click"/>
                        <Button Content="{Binding [ShowLastImport], Source={StaticResource I18n}}" Click="ShowLastImport_Click"/>
                        <Button Content="{Binding [ShowAllCatalog], Source={StaticResource I18n}}" Click="ShowAllCatalog_Click"/>
                        <TextBlock Text="{Binding [Collections], Source={StaticResource I18n}}" FontWeight="SemiBold" Margin="4,16,4,4"/>
                        <ListBox x:Name="CollectionsList" MinHeight="100" MaxHeight="350" DisplayMemberPath="DisplayName" BorderThickness="0" Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" SelectionChanged="CollectionsList_SelectionChanged"/>
                        <Button Content="{Binding [SetTargetExisting], Source={StaticResource I18n}}" Click="SetTarget_Click"/>
                        <TextBlock Text="{Binding [TargetShortcut], Source={StaticResource I18n}}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="4,10,4,8"/>
                    </StackPanel>
                    <GroupBox Header="{Binding [LastImport], Source={StaticResource I18n}}" DockPanel.Dock="Bottom">
                        <TextBlock x:Name="LastImportText" Text="{Binding [NoImportSession], Source={StaticResource I18n}}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                    </GroupBox>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
                <Grid.RowDefinitions><RowDefinition x:Name="PreviewRow" Height="*"/><RowDefinition x:Name="BrowserRow" Height="190"/></Grid.RowDefinitions>
                <Border x:Name="PreviewBorder" CornerRadius="8" Margin="12" Background="{DynamicResource PreviewBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="14"/>
                        <TextBlock x:Name="PreviewWatermarkText" Visibility="Collapsed" Foreground="White" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock x:Name="EmptyPreviewText" Text="{Binding [ImportPhotosPreview], Source={StaticResource I18n}}" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                    </Grid>
                </Border>
                <ListView Grid.Row="1" x:Name="FilesList" MouseDoubleClick="OpenEditor_DoubleClick" Padding="12" ItemsSource="{Binding Files}" SelectionChanged="FilesList_SelectionChanged" Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" SelectionMode="Extended">
                    <ListView.ItemsPanel><ItemsPanelTemplate><WrapPanel IsItemsHost="True"/></ItemsPanelTemplate></ListView.ItemsPanel>
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="Card" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="5"><ContentPresenter/></Border>
                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#60A5FA"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Card" Property="BorderThickness" Value="3"/><Setter TargetName="Card" Property="Padding" Value="3"/></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></Setter.Value></Setter>
                    </Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="174" Height="166" ToolTip="{Binding PreviewError}">
                                <Grid.RowDefinitions><RowDefinition Height="128"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border Background="{DynamicResource PreviewBackgroundBrush}" CornerRadius="5" ClipToBounds="True">
                                    <Grid><TextBlock Text="{Binding Status}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/><Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="3"/></Grid>
                                </Border>
                                <DockPanel Grid.Row="1" Margin="3,6,3,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <ScrollViewer x:Name="EditorScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="{DynamicResource PanelBackgroundBrush}">
                <StackPanel x:Name="EditorPanel">
                    <GroupBox Header="{Binding [EditBasic], Source={StaticResource I18n}}">
                        <StackPanel>
                            <Button Content="{Binding [CopySettings], Source={StaticResource I18n}}" Click="CopySettings_Click"/>
                            <Button Content="{Binding [PasteSelected], Source={StaticResource I18n}}" Click="PasteSettings_Click"/>
                            <Button Content="{Binding [SavePreset], Source={StaticResource I18n}}" Click="SavePreset_Click"/>
                            <Button Content="{Binding [ApplyPreset], Source={StaticResource I18n}}" Click="ApplyPreset_Click"/>
                            <TextBlock Text="{Binding [Exposure], Source={StaticResource I18n}}"/><Slider x:Name="ExposureSlider" Minimum="-5" Maximum="5" ValueChanged="BasicSlider_ValueChanged"/><TextBlock x:Name="ExposureValue" Text="0.00" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding [Contrast], Source={StaticResource I18n}}"/><Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" ValueChanged="BasicSlider_ValueChanged"/><TextBlock x:Name="ContrastValue" Text="0" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding [Highlights], Source={StaticResource I18n}}"/><Slider x:Name="HighlightsSlider" Minimum="-100" Maximum="100" ValueChanged="BasicSlider_ValueChanged"/><TextBlock x:Name="HighlightsValue" Text="0" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding [Shadows], Source={StaticResource I18n}}"/><Slider x:Name="ShadowsSlider" Minimum="-100" Maximum="100" ValueChanged="BasicSlider_ValueChanged"/><TextBlock x:Name="ShadowsValue" Text="0" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding [Whites], Source={StaticResource I18n}}"/><Slider x:Name="WhitesSlider" Minimum="-100" Maximum="100" ValueChanged="BasicSlider_ValueChanged"/><TextBlock x:Name="WhitesValue" Text="0" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding [Blacks], Source={StaticResource I18n}}"/><Slider x:Name="BlacksSlider" Minimum="-100" Maximum="100" ValueChanged="BasicSlider_ValueChanged"/><TextBlock x:Name="BlacksValue" Text="0" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding [Saturation], Source={StaticResource I18n}}"/><Slider x:Name="SaturationSlider" Minimum="-100" Maximum="100" ValueChanged="BasicSlider_ValueChanged"/><TextBlock x:Name="SaturationValue" Text="0" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="{Binding [Export], Source={StaticResource I18n}}">
                        <StackPanel>
                            <Button Content="{Binding [ExportCurrent], Source={StaticResource I18n}}" Click="ExportCurrent_Click"/>
                            <Button Content="{Binding [ExportSelected], Source={StaticResource I18n}}" Click="ExportSelected_Click"/>
                            <TextBlock Text="{Binding [BatchSubfolder], Source={StaticResource I18n}}"/><TextBox x:Name="ExportSubfolderTextBox" Text=""/>
                            <TextBlock Text="{Binding [BatchFormat], Source={StaticResource I18n}}"/><ComboBox x:Name="ExportFormatComboBox" SelectedIndex="0"><ComboBoxItem Content="JPEG"/><ComboBoxItem Content="PNG"/></ComboBox>
                            <TextBlock Text="{Binding [OutputWidth], Source={StaticResource I18n}}"/><TextBox x:Name="ExportWidthTextBox" Text="0" TextChanged="ExportOptionsChanged"/>
                            <TextBlock Text="{Binding [OutputHeight], Source={StaticResource I18n}}"/><TextBox x:Name="ExportHeightTextBox" Text="0" TextChanged="ExportOptionsChanged"/>
                            <TextBlock Text="{Binding [WatermarkText], Source={StaticResource I18n}}"/><TextBox x:Name="WatermarkTextBox" TextChanged="ExportOptionsChanged"/>
                            <TextBlock Text="{Binding [WatermarkOpacity], Source={StaticResource I18n}}"/><Slider x:Name="WatermarkOpacitySlider" Minimum="0" Maximum="100" Value="65" ValueChanged="ExportOptionsChanged"/><TextBlock x:Name="WatermarkOpacityValue" Text="65" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding [WatermarkPosition], Source={StaticResource I18n}}"/>
                            <ComboBox x:Name="WatermarkPositionComboBox" SelectionChanged="ExportOptionsChanged">
                                <ComboBoxItem Tag="top_left" Content="{Binding [PositionTopLeft], Source={StaticResource I18n}}"/>
                                <ComboBoxItem Tag="top_right" Content="{Binding [PositionTopRight], Source={StaticResource I18n}}"/>
                                <ComboBoxItem Tag="center" Content="{Binding [PositionCenter], Source={StaticResource I18n}}"/>
                                <ComboBoxItem Tag="bottom_left" Content="{Binding [PositionBottomLeft], Source={StaticResource I18n}}"/>
                                <ComboBoxItem Tag="bottom_right" Content="{Binding [PositionBottomRight], Source={StaticResource I18n}}" IsSelected="True"/>
                            </ComboBox>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="{Binding [EditSections], Source={StaticResource I18n}}">
                        <StackPanel>
                            <Expander Header="{Binding [ToneCurve], Source={StaticResource I18n}}"><StackPanel>
                                <TextBlock Text="{Binding [ToneCurveDescription], Source={StaticResource I18n}}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="6,6,6,2"/>
                                <TextBlock Text="{Binding [Shadows], Source={StaticResource I18n}}"/><Slider x:Name="ToneCurveShadowsSlider" Minimum="-100" Maximum="100" ValueChanged="ToneCurveSlider_ValueChanged"/><TextBlock x:Name="ToneCurveShadowsValue" Text="0" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding [Darks], Source={StaticResource I18n}}"/><Slider x:Name="ToneCurveDarksSlider" Minimum="-100" Maximum="100" ValueChanged="ToneCurveSlider_ValueChanged"/><TextBlock x:Name="ToneCurveDarksValue" Text="0" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding [Lights], Source={StaticResource I18n}}"/><Slider x:Name="ToneCurveLightsSlider" Minimum="-100" Maximum="100" ValueChanged="ToneCurveSlider_ValueChanged"/><TextBlock x:Name="ToneCurveLightsValue" Text="0" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding [Highlights], Source={StaticResource I18n}}"/><Slider x:Name="ToneCurveHighlightsSlider" Minimum="-100" Maximum="100" ValueChanged="ToneCurveSlider_ValueChanged"/><TextBlock x:Name="ToneCurveHighlightsValue" Text="0" HorizontalAlignment="Right"/>
                            </StackPanel></Expander>
                            <Expander Header="{Binding [ColorMixer], Source={StaticResource I18n}}"><StackPanel>
                                <TextBlock Text="{Binding [ColorMixerDescription], Source={StaticResource I18n}}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="6,6,6,2"/>
                                <ComboBox x:Name="ColorMixerChannelComboBox" SelectionChanged="ColorMixerChannelChanged">
                                    <ComboBoxItem Tag="red" Content="{Binding [ColorRed], Source={StaticResource I18n}}"/><ComboBoxItem Tag="orange" Content="{Binding [ColorOrange], Source={StaticResource I18n}}"/><ComboBoxItem Tag="yellow" Content="{Binding [ColorYellow], Source={StaticResource I18n}}"/><ComboBoxItem Tag="green" Content="{Binding [ColorGreen], Source={StaticResource I18n}}"/><ComboBoxItem Tag="aqua" Content="{Binding [ColorAqua], Source={StaticResource I18n}}"/><ComboBoxItem Tag="blue" Content="{Binding [ColorBlue], Source={StaticResource I18n}}"/><ComboBoxItem Tag="purple" Content="{Binding [ColorPurple], Source={StaticResource I18n}}"/><ComboBoxItem Tag="magenta" Content="{Binding [ColorMagenta], Source={StaticResource I18n}}"/>
                                </ComboBox>
                                <TextBlock Text="{Binding [Hue], Source={StaticResource I18n}}"/><Slider x:Name="ColorMixerHueSlider" Minimum="-100" Maximum="100" ValueChanged="ColorMixerSlider_ValueChanged"/><TextBlock x:Name="ColorMixerHueValue" Text="0" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding [Saturation], Source={StaticResource I18n}}"/><Slider x:Name="ColorMixerSaturationSlider" Minimum="-100" Maximum="100" ValueChanged="ColorMixerSlider_ValueChanged"/><TextBlock x:Name="ColorMixerSaturationValue" Text="0" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding [Luminance], Source={StaticResource I18n}}"/><Slider x:Name="ColorMixerLuminanceSlider" Minimum="-100" Maximum="100" ValueChanged="ColorMixerSlider_ValueChanged"/><TextBlock x:Name="ColorMixerLuminanceValue" Text="0" HorizontalAlignment="Right"/>
                            </StackPanel></Expander>
                            <Expander Header="{Binding [LensCorrections], Source={StaticResource I18n}}"><StackPanel>
                                <TextBlock Text="{Binding [LensDescription], Source={StaticResource I18n}}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="6,6,6,2"/>
                                <ComboBox x:Name="LensProfileComboBox" SelectionChanged="LensCorrectionOptionChanged">
                                    <ComboBoxItem Content="manual"/><ComboBoxItem Content="Canon EF 24-70 f/2.8L I"/><ComboBoxItem Content="Canon EF 24-70 f/2.8L II"/><ComboBoxItem Content="Sony 24-70 f/2.8 GM I"/><ComboBoxItem Content="Sony 24-70 f/2.8 GM II"/><ComboBoxItem Content="Sony 70-200 f/2.8 GM I"/><ComboBoxItem Content="Sony 70-200 f/2.8 GM II (unverified)"/><ComboBoxItem Content="Sony 16-35 f/2.8 GM I"/><ComboBoxItem Content="Sony 16-35 f/2.8 GM II (unverified)"/><ComboBoxItem Content="Sony 100-400 GM I"/><ComboBoxItem Content="Sony 100-400 GM II (unverified)"/><ComboBoxItem Content="Sony 18-135 f/4G (verify EXIF)"/><ComboBoxItem Content="Tamron 17-70 f/2.8"/><ComboBoxItem Content="Sigma 24-70 f/2.8 Art I"/><ComboBoxItem Content="Sigma 24-70 f/2.8 Art II"/>
                                </ComboBox>
                                <CheckBox x:Name="LensProfileEnabledCheckBox" Content="{Binding [EnableProfile], Source={StaticResource I18n}}" Checked="LensCorrectionOptionChanged" Unchecked="LensCorrectionOptionChanged" Margin="0,4"/>
                                <TextBlock Text="{Binding [ManualDistortion], Source={StaticResource I18n}}"/><Slider x:Name="LensDistortionSlider" Minimum="-100" Maximum="100" ValueChanged="LensCorrectionOptionChanged"/><TextBlock x:Name="LensDistortionValue" Text="0" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding [ManualVignetting], Source={StaticResource I18n}}"/><Slider x:Name="LensVignettingSlider" Minimum="-100" Maximum="100" ValueChanged="LensCorrectionOptionChanged"/><TextBlock x:Name="LensVignettingValue" Text="0" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="LensCorrectionStatus" Text="{Binding [LensStatusDefault], Source={StaticResource I18n}}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4"/>
                            </StackPanel></Expander>
                            <Expander Header="{Binding [TransformCrop], Source={StaticResource I18n}}"><StackPanel>
                                <TextBlock Text="{Binding [CropDescription], Source={StaticResource I18n}}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="6,6,6,2"/>
                                <TextBlock Text="{Binding [AspectRatio], Source={StaticResource I18n}}"/>
                                <ComboBox x:Name="CropAspectComboBox" SelectionChanged="CropOptionChanged"><ComboBoxItem Tag="original" Content="{Binding [AspectOriginal], Source={StaticResource I18n}}"/><ComboBoxItem Tag="1:1" Content="1:1"/><ComboBoxItem Tag="4:3" Content="4:3"/><ComboBoxItem Tag="3:2" Content="3:2"/><ComboBoxItem Tag="16:9" Content="16:9"/></ComboBox>
                                <TextBlock Text="{Binding [Angle], Source={StaticResource I18n}}"/><Slider x:Name="CropAngleSlider" Minimum="-45" Maximum="45" ValueChanged="CropOptionChanged"/><TextBlock x:Name="CropAngleValue" Text="0.0" HorizontalAlignment="Right"/>
                                <Button Content="{Binding [AutoStraighten], Source={StaticResource I18n}}" Click="AutoStraighten_Click"/><Button Content="{Binding [ResetCrop], Source={StaticResource I18n}}" Click="ResetCrop_Click"/>
                                <TextBlock Text="{Binding [AutoStraightenHint], Source={StaticResource I18n}}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="6"/>
                            </StackPanel></Expander>
                            <Expander Header="{Binding [Mask], Source={StaticResource I18n}}"><StackPanel>
                                <TextBlock Text="{Binding [MaskDescription], Source={StaticResource I18n}}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="6,6,6,2"/>
                                <Button Content="{Binding [ChooseMask], Source={StaticResource I18n}}" Click="ChooseMask_Click"/><Button Content="{Binding [PaintMask], Source={StaticResource I18n}}" Click="PaintMask_Click"/><Button Content="{Binding [AutoSubjectMask], Source={StaticResource I18n}}" Click="AutoSubjectMask_Click"/><Button Content="{Binding [ClearMask], Source={StaticResource I18n}}" Click="ClearMask_Click"/>
                                <TextBlock x:Name="MaskPathText" Text="{Binding [NoMaskSelected], Source={StaticResource I18n}}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="6,2"/>
                                <CheckBox x:Name="MaskInvertCheckBox" Content="{Binding [InvertMask], Source={StaticResource I18n}}" Checked="MaskOptionChanged" Unchecked="MaskOptionChanged" Margin="6"/>
                                <TextBlock Text="{Binding [MaskExposure], Source={StaticResource I18n}}"/><Slider x:Name="MaskExposureSlider" Minimum="-5" Maximum="5" ValueChanged="MaskSlider_ValueChanged"/><TextBlock x:Name="MaskExposureValue" Text="0.00" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding [MaskHint], Source={StaticResource I18n}}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="6"/>
                            </StackPanel></Expander>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
